# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor / IDE files
.idea/
*.swp
*~
# VS Code: commit the curated shared project config, ignore everything else
# (extensions auto-write machine-specific files into .vscode/). The broad ignore
# MUST come before the `!` whitelist — later rules win in .gitignore. `!/.vscode/`
# re-includes the DIRECTORY first: a global excludesFile with a bare `.vscode/`
# is common, and git never descends into an ignored directory, so without it the
# file-level whitelist below silently does nothing for those users. Anchored with
# a leading slash so it only re-includes the ROOT .vscode/ — an unanchored
# `!.vscode/` would also un-ignore nested ones (e.g. packages/foo/.vscode/ in a
# monorepo) whose machine-specific files the root-anchored `.vscode/*` above
# does not cover.
.vscode/*
!/.vscode/
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

# Homebrew lockfile (generated by `brew bundle`)
Brewfile.lock.json

# Node dependencies — kept in every profile (a local node_modules can appear from
# ad-hoc npm or a v2->v3 migration even in non-node repos). Build output and the
# pnpm store stay node-profile-only, in the use_node block below.
node_modules/

# logs and databases
*.log
*.sql
*.sqlite
*.sqlite3

# Node (npx caches deps for markdownlint-cli2 / commitlint; no tracked package.json)
node_modules/

# Taskfile fingerprint cache
.task/

# Git worktrees
.worktrees/
# Agent-tool worktree isolation dir. A registered worktree is recorded as a
# gitlink with no `.gitmodules` entry, so leaving it untracked-but-unignored
# dirties `git status` and lets any tool that stages with `git add -A` commit a
# submodule-shaped entry that later clones cannot resolve. Anchored by its
# embedded slash (git anchors any pattern containing a non-trailing `/`), so it
# matches only the repository-root `.claude/`.
.claude/worktrees/

# Design handoff bundles (Claude Design exports) live as specs/ subdirectories
# while being implemented and are deleted at sign-off — never committed.
# Top-level specs/*.md (README, _template, feature specs) stay tracked.
specs/*/

# Lefthook local overrides (not committed)
.lefthook-local.yml

# Local editor/AI settings
settings.local.json

# Scratch — anchored to root. (`.meta/` and the `*.code-workspace` are tracked;
# `.DS_Store` above still keeps macOS cruft out of `.meta/`.)
/todo.md

# Foreman runtime artifacts (logs, prompts, resume states — never state-of-record)
.foreman/
.foreman-stop

# Python bytecode. Foreman used to ship in-repo Python; a checkout that ran that
# version keeps an orphaned scripts/foreman/__pycache__ which was never tracked,
# so `git status` is dirty before anyone edits anything. (Python projects ignore
# these in the block above.)
__pycache__/
*.pyc

# Devcontainer env files (injected locally via 1Password, never committed)
.devcontainer/**/devcontainer.env

# Devcontainer feature lockfile — regenerated on each container build (pins
# resolved feature digests); a local build artifact, never committed.
.devcontainer/**/devcontainer-lock.json

#             .env
#------------------------------------------------------------------------------
# Ignore all .env files everywhere (secrets live in 1Password; see docs/CHECKLIST.md)
.env
**/.env
.env.*
**/.env.*
.env/
# ...but keep the committed example (documents required vars; contains no secrets).
!/.env.example
