{
  // Rules live in .markdownlint.json; markdownlint-cli2 auto-merges both files.
  // This file only adds cli2-specific options.
  //
  // CHANGELOG.md is generated by release-please (which writes double blank lines
  // between sections, tripping MD012). It is not hand-edited, so never lint or
  // auto-fix it — doing so creates spurious churn on every `task verify`.
  //
  // Vendored agent assets — .claude/skills/**, .agents/skills/**, and _bmad/** —
  // are installer-owned and may be overwritten on reinstall. Their markdown
  // follows upstream conventions, and linting/--fix-ing it mangles content
  // (e.g. MD004 rewrites a leading "+ " in prose to "- "), so exclude these
  // trees everywhere. Without this, the lefthook markdown hook (which passes
  // staged files explicitly) would still touch them even though
  // `task lint:markdown` skips them via its glob.
  //
  // The remaining entries are gitignored artifact/cache dirs that can exist on
  // disk (terraform provider cache, uv venv, go-task cache, npm deps) —
  // markdownlint-cli2 does not read .gitignore, and while `task lint:markdown`
  // excludes them via its glob, direct cli2 invocations (editor integrations,
  // `format`) would otherwise scan them. Matching nothing is a no-op.
  "ignores": [
    "CHANGELOG.md",
    ".claude/**",
    ".agents/skills/**",
    "_bmad/**",
    "**/.terraform/**",
    "**/.venv/**",
    "**/.task/**",
    "**/node_modules/**"
  ]
}
