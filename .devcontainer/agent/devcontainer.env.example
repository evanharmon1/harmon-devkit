# AGENT posture env-file. init-env.sh --profile agent admits ONLY these names
# and refuses to build if the file holds anything else — no GH_TOKEN, no
# FOREMAN_AGENT_GH_TOKEN, no TS_AUTHKEY, no 1Password token, no
# ANTHROPIC_API_KEY. See docs/guides/devcontainers.md.
#
# The agent's own fine-grained PAT on the bot account (never the bot's
# GH_TOKEN) — see docs/guides/bot-account.md:
AGENT_GH_TOKEN=example-changeme
CLAUDE_CODE_OAUTH_TOKEN=example-changeme
# Alternative Claude Code providers (only when use_alternative_claude_providers=true):
# uncomment these only when that answer is true — with it false the agent
# env-file admits none of them, and the build refuses a file that sets one.
# KIMI_API_KEY=example-changeme
# DEEPSEEK_API_KEY=example-changeme
# ZAI_API_KEY=example-changeme
# QWEN_API_KEY=example-changeme
