{
  "model": "Gemini 3.7 Flash (High)",
  "toolPermission": "request-review",
  "artifactReviewPolicy": "always-proceed",
  "permissions": {
    "allow": [
      "command(task)",
      "command(git)",
      "command(gh)",
      "command(ls)",
      "command(cat)",
      "command(bat)",
      "command(head)",
      "command(tail)",
      "command(grep)",
      "command(rg)",
      "command(fd)",
      "command(find)",
      "command(wc)",
      "command(sort)",
      "command(uniq)",
      "command(cut)",
      "command(tr)",
      "command(diff)",
      "command(jq)",
      "command(yq)",
      "command(tree)",
      "command(which)",
      "command(echo)",
      "command(printf)",
      "command(pwd)",
      "command(env)",
      "command(date)",
      "command(mise)",
      "command(uv)",
      "command(python)",
      "command(python3)",
      "command(pip)",
      "command(node)",
      "command(npm)",
      "command(pnpm)",
      "command(yarn)",
      "command(pytest)",
      "command(make)",
      "command(go)",
      "command(cargo)",
      "command(docker)",
      "command(kubectl)",
      "command(terraform)",
      "command(lefthook)",
      "command(shellcheck)",
      "command(shfmt)",
      "command(yamllint)",
      "command(actionlint)",
      "command(ansible-lint)",
      "command(semgrep)",
      "command(gitleaks)"
    ],
    "deny": [
      "command(rm -rf /)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/etc/claude-code/statusline.sh",
    "enabled": true,
    "stack_with_default": true
  },
  "showFeedbackSurvey": false
}
