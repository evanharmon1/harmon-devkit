{
  // Primary profile for AI agents (Claude Code, Codex, OpenCode, Antigravity,
  // Copilot CLI, pi, oh-my-pi).
  // Secrets (GH_TOKEN) come from the --env-file, not containerEnv.
  // Tailscale is not installed in this profile — see dev/ for the human profile.
  "name": "BOT - devcontainer-harmon-devkit",
  "containerName": "devcontainer-harmon-devkit-bot",
  // Minimum to run the intended workload (Playwright + agents). Codespaces
  // enforces it; local Docker / Coder may not — see
  // docs/guides/devcontainer-performance.md for recommended sizing.
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  },
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "cacheFrom": "ghcr.io/evanharmon1/harmon-devkit-devcontainer"
  },
  // Bot profile intentionally omits TS_AUTHKEY from the allow-list — this
  // container has no Tailscale feature installed, and we don't want a tailnet
  // auth key sitting in its env-file. init-env.sh will strip any stale
  // TS_AUTHKEY entry on every rebuild.
  // Alternative-model provider keys (KIMI/DEEPSEEK/ZAI) are opt-in via
  // use_alternative_claude_providers; when on they land in this env-file too,
  // so a headless/bypass bot can read them — a deliberate posture extension.
  "initializeCommand": "bash .devcontainer/scripts/init-env.sh .devcontainer/devcontainer.env GH_TOKEN FOREMAN_AGENT_GH_TOKEN CLAUDE_CODE_OAUTH_TOKEN AGENT_DECK_TELEGRAM_KEY KIMI_API_KEY MOONSHOT_API_KEY DEEPSEEK_API_KEY ZAI_API_KEY QWEN_API_KEY",
  "runArgs": [
    "--init",
    "--shm-size=2g",
    // Linux hosts don't resolve host.docker.internal by default (unlike Docker
    // Desktop on mac/win/WSL2); this mapping makes it resolve everywhere,
    // which claude-qwen-local() (.devcontainer/config/claude-providers.sh)
    // relies on to reach an Ollama/LM Studio endpoint on the host. Supported
    // since Docker 20.10, harmless where the platform already resolves it.
    "--add-host=host.docker.internal:host-gateway",
    "--env-file",
    ".devcontainer/devcontainer.env"
  ],
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.14"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "dockerDashComposeVersion": "v2"
    },
    // No 1Password CLI in the bot profile — this container must hold no path
    // to production secrets (docs/guides/devcontainers.md). The human dev
    // profile (.devcontainer/dev/) keeps its own op feature.
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "mounts": [
    "source=claude-code-config-evanharmon1-harmon-devkit,target=/home/vscode/.claude,type=volume",
    "source=codex-config-evanharmon1-harmon-devkit,target=/home/vscode/.codex,type=volume",
    "source=gemini-config-evanharmon1-harmon-devkit${localEnv:HARMON_DEVCONTAINER_SMOKE_VOLUME_SUFFIX},target=/home/vscode/.gemini,type=volume",
    "source=copilot-config-evanharmon1-harmon-devkit${localEnv:HARMON_DEVCONTAINER_SMOKE_VOLUME_SUFFIX},target=/home/vscode/.copilot,type=volume",
    "source=pi-config-evanharmon1-harmon-devkit${localEnv:HARMON_DEVCONTAINER_SMOKE_VOLUME_SUFFIX},target=/home/vscode/.pi,type=volume",
    "source=omp-config-evanharmon1-harmon-devkit${localEnv:HARMON_DEVCONTAINER_SMOKE_VOLUME_SUFFIX},target=/home/vscode/.omp,type=volume",
    "source=agent-deck-config-evanharmon1-harmon-devkit,target=/home/vscode/.agent-deck,type=volume",
    "source=herdr-config-evanharmon1-harmon-devkit,target=/home/vscode/.config/herdr,type=volume",
    "source=opencode-config-evanharmon1-harmon-devkit${localEnv:HARMON_DEVCONTAINER_SMOKE_VOLUME_SUFFIX},target=/home/vscode/.config/opencode,type=volume",
    "source=opencode-data-evanharmon1-harmon-devkit,target=/home/vscode/.local/share/opencode,type=volume",
    "source=shell-history-evanharmon1-harmon-devkit,target=/home/vscode/.shell-history,type=volume",
    "source=zoxide-data-evanharmon1-harmon-devkit,target=/home/vscode/.local/share/zoxide,type=volume"
  ],
  // Secrets (GH_TOKEN) are populated into the --env-file by init-env.sh
  // (from 1Password locally, or from host env on Coder/Codespaces).
  // Do NOT forward them via containerEnv — ${localEnv:...} resolves to ""
  // when the host shell doesn't export them, which overrides the env-file
  // values (Docker --env takes precedence over --env-file).
  //
  // FOREMAN_DEVCONTAINER: foreman's D2 startup tripwire — it refuses to run
  // anywhere this marker is not "bot" (only the bot profile sets it).
  //
  // HARMON_BOT_AUTONOMY_ANTIGRAVITY: rendered from use_antigravity_cli — the
  // ONLY channel the verbatim, template-twinned ensure-antigravity-cli.sh
  // and bot-autonomy/antigravity.sh may read to learn that per-repo Copier
  // answer. See https://github.com/evanharmon1/harmon-init/blob/main/openspec/changes/archive/2026-09-05-bot-autonomy-bootstrap/design.md - Decisions.
  //
  // HARMON_BOT_AUTONOMY_COPILOT / COPILOT_ALLOW_ALL: rendered from
  // use_copilot_cli — BOT PROFILE ONLY, unlike the Antigravity marker above
  // which both twins carry. Nothing in the dev profile reads either one, and
  // COPILOT_ALLOW_ALL is a plain environment variable Copilot CLI honors in
  // whichever profile sets it: rendering it into dev too would silently hand
  // a human's own interactive Copilot session full allow-all permissions.
  // COPILOT_ALLOW_ALL is rendered explicitly in BOTH states ("true"/"false"),
  // never omitted — the bot profile also loads devcontainer.env via
  // --env-file, init-env.sh does not manage or evict this variable, and
  // containerEnv only outranks --env-file for a key it actually specifies.
  //
  // PATH (~/.local/bin ahead of /usr/local/bin, so the Antigravity autonomy
  // wrapper's precedence over the system agy binary holds for a `docker
  // exec` or a programmatic launcher too, not just interactive shells) is
  // set in the Dockerfile, not here: containerEnv's ${containerEnv:PATH}
  // cannot self-expand while Docker is creating the container — it is
  // passed to `docker run -e` literally, unresolved. A Dockerfile ENV
  // directive is Docker's own, working self-reference and applies
  // identically to any docker exec, so it belongs in the image build, not
  // this runtime layer.
  "containerEnv": {
    "CODER": "${localEnv:CODER}",
    "AGY_CLI_DISABLE_AUTO_UPDATE": "true",
    "FOREMAN_DEVCONTAINER": "bot",
    "HARMON_BOT_AUTONOMY_ANTIGRAVITY": "enabled",
    "HARMON_BOT_AUTONOMY_COPILOT": "disabled",
    "COPILOT_ALLOW_ALL": "false"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "customizations": {
    "coder": {
      "name": "devcontainer"
    },
    "vscode": {
      "settings": {
        "terminal.integrated.inheritEnv": true,
        "python.defaultInterpreterPath": ".venv/bin/python",
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter"
        },
        "debug.javascript.autoAttachFilter": "disabled",
        "terminal.integrated.env.linux": {
          "NODE_OPTIONS": "",
          "BROWSER": ""
        },
        "remote.autoForwardPortsSource": "output",
        "terminal.integrated.minimumContrastRatio": 1,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "extensions.ignoreRecommendations": false
      },
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "ms-python.black-formatter",
        "esbenp.prettier-vscode",
        "timonwong.shellcheck",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "mikestead.dotenv",
        "davidanson.vscode-markdownlint",
        "foxundermoon.shell-format",
        "GitHub.vscode-github-actions",
        "github.vscode-pull-request-github",
        "task.vscode-task",
        "EditorConfig.EditorConfig",
        "anthropic.claude-code",
        "openai.chatgpt",
        "ms-playwright.playwright"
      ]
    }
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "forwardPorts": [
    8420
  ],
  "portsAttributes": {
    "8420": {
      "label": "Agent Deck Web UI",
      "onAutoForward": "notify"
    }
  }
}
