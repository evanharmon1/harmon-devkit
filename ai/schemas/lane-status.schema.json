{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/evanharmon1/harmon-devkit/ai/schemas/lane-status.schema.json",
  "title": "Dev flow v2 lane status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "seq",
    "stage",
    "round",
    "head",
    "updated_at",
    "summary"
  ],
  "properties": {
    "state": {
      "enum": [
        "working",
        "decision-request",
        "handoff",
        "blocked",
        "done"
      ]
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "^[^\\r\\n]+$"
    },
    "stage": {
      "enum": [
        "implement",
        "verify",
        "challenge",
        "review",
        "security",
        "integration"
      ]
    },
    "round": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "head": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n\\t]+$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "decision-request"
          }
        }
      },
      "then": {
        "required": [
          "request_id"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "else": {
        "properties": {
          "request_id": {
            "type": "null"
          }
        }
      }
    }
  ]
}
