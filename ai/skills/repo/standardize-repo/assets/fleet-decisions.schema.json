{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/fleet-decisions.schema.json",
  "title": "Fleet decisions v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fleet",
    "releases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "fleet": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scope",
          "ruling",
          "approved_by",
          "approved_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]*$"
          },
          "scope": {
            "const": "fleet"
          },
          "ruling": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "approved_by": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "approved_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "releases": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "scope",
                "ruling",
                "approved_by",
                "approved_on"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_-]*$"
                },
                "scope": {
                  "const": "release"
                },
                "ruling": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "approved_by": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "approved_on": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "scope",
                "ruling",
                "approved_by",
                "approved_on",
                "repository"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_-]*$"
                },
                "scope": {
                  "const": "repository"
                },
                "ruling": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "approved_by": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "approved_on": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "repository": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                }
              }
            }
          ]
        }
      }
    }
  }
}
