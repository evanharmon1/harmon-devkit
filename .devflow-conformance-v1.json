{
  "schema_version": 1,
  "kind": "harmon-init.devflow.conformance",
  "description": "Language-neutral v1 inputs and normalized-result expectations for .devflow.toml consumers.",
  "result_schema_version": 1,
  "cases": [
    {
      "name": "defaults",
      "basis": "branch",
      "expect": {
        "exit": 0,
        "result": {
          "result_schema_version": 1,
          "config_source": "branch",
          "config_schema_version": 1,
          "selections": {
            "rigor": { "value": "standard", "source": "default" },
            "strategy": { "value": "plan", "source": "default" }
          },
          "review": {
            "challenge": 3,
            "review": 3,
            "shepherd": 4,
            "min_rounds": 1,
            "min_rounds_scope": ["challenge", "review"],
            "policy": "standard",
            "source": "profile"
          },
          "tiers": {
            "orchestrator": {
              "value": "frontier",
              "requested": "frontier",
              "source": "profile",
              "off_profile": false,
              "preflight_required": false
            },
            "implementer": {
              "value": "standard",
              "requested": "standard",
              "source": "profile",
              "off_profile": false,
              "preflight_required": false
            },
            "reviewer": {
              "value": "frontier",
              "requested": "frontier",
              "source": "profile",
              "off_profile": false,
              "preflight_required": false
            }
          },
          "budget": {
            "name": "standard",
            "source": "profile",
            "max_agent_runs": 6,
            "max_parallel_agents": 3,
            "wall_clock_min": 120,
            "allow_tier_escalation": true
          },
          "strategy_fields": {
            "topology": "single-agent",
            "planning": "explicit",
            "delegation": "optional",
            "human_gates": [],
            "description": "Strategy: agent plans then implements; no human plan gate"
          },
          "disclosure": {
            "off_default": false,
            "off_profile": false,
            "same_family_reviewer": null
          },
          "requires_confirmation": false,
          "preflight_required": false,
          "warnings": [],
          "errors": []
        }
      }
    },
    {
      "name": "explicit-overrides-win",
      "basis": "branch",
      "labels": ["rigor:trivial", "strategy:orchestrate"],
      "overrides": ["rigor=deep", "strategy=plan"],
      "expect": {
        "exit": 0,
        "result": {
          "selections": {
            "rigor": { "value": "deep", "source": "explicit" },
            "strategy": { "value": "plan", "source": "explicit" }
          },
          "review": {
            "challenge": 5,
            "review": 5,
            "shepherd": 6,
            "min_rounds": 1,
            "policy": "deep",
            "source": "profile"
          },
          "tiers": {
            "orchestrator": { "value": "apex", "requested": "apex", "source": "profile" },
            "implementer": { "value": "frontier", "requested": "frontier", "source": "profile" },
            "reviewer": { "value": "apex", "requested": "apex", "source": "profile" }
          },
          "budget": {
            "name": "deep",
            "source": "profile",
            "max_agent_runs": 20,
            "max_parallel_agents": 4,
            "wall_clock_min": 480,
            "allow_tier_escalation": true
          },
          "disclosure": { "off_default": true },
          "requires_confirmation": false
        }
      }
    },
    {
      "name": "retired-method-label-is-ignored",
      "basis": "branch",
      "labels": ["method:council"],
      "expect": {
        "exit": 0,
        "result": {
          "selections": {
            "rigor": { "value": "standard", "source": "default" },
            "strategy": { "value": "plan", "source": "default" }
          },
          "warnings": []
        }
      }
    },
    {
      "name": "explicit-nondefault-strategy-projects-fields",
      "basis": "branch",
      "overrides": ["strategy=orchestrate"],
      "expect": {
        "exit": 0,
        "result": {
          "selections": { "strategy": { "value": "orchestrate", "source": "explicit" } },
          "strategy_fields": {
            "topology": "lead-and-workers",
            "planning": "explicit",
            "delegation": "required",
            "human_gates": [],
            "coordination": "parallel-when-independent",
            "min_agents": 2,
            "description": "Strategy: lead agent delegates bounded work to parallel workers"
          },
          "disclosure": { "off_default": true }
        }
      }
    },
    {
      "name": "explicit-council-projects-independent-proposals-fields",
      "basis": "branch",
      "overrides": ["strategy=council"],
      "expect": {
        "exit": 0,
        "result": {
          "selections": { "strategy": { "value": "council", "source": "explicit" } },
          "strategy_fields": {
            "topology": "independent-proposals",
            "planning": "independent",
            "delegation": "required",
            "human_gates": [],
            "selection": "judge",
            "synthesis": true,
            "min_agents": 2,
            "description": "Strategy: independent proposals, judged; best or synthesis wins (2+ agents)"
          }
        }
      }
    },
    {
      "name": "explicit-plan-approved-projects-human-gate",
      "basis": "branch",
      "overrides": ["strategy=plan-approved"],
      "expect": {
        "exit": 0,
        "result": {
          "selections": { "strategy": { "value": "plan-approved", "source": "explicit" } },
          "strategy_fields": {
            "topology": "single-agent",
            "planning": "explicit",
            "delegation": "optional",
            "human_gates": ["after-plan"],
            "description": "Strategy: plan requires human approval before implementation"
          }
        }
      }
    },
    {
      "name": "explicit-human-led-projects-human-directed-fields",
      "basis": "branch",
      "overrides": ["strategy=human-led"],
      "expect": {
        "exit": 0,
        "result": {
          "selections": { "strategy": { "value": "human-led", "source": "explicit" } },
          "strategy_fields": {
            "topology": "human-directed",
            "planning": "collaborative",
            "delegation": "optional",
            "human_gates": ["after-discovery", "after-plan", "before-publication"],
            "description": "Strategy: human owns central decisions; AI does bounded pieces"
          }
        }
      }
    },
    {
      "name": "interactive-untrusted-label-needs-confirmation",
